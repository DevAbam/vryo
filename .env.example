# Copy to .env.local for local development. Never commit real values.
# Local values come from `npx supabase status -o env` after `npm run db:start`.

# --- Browser-safe (NEXT_PUBLIC_*) — shipped to the client, protected by RLS ---
# Supabase API URL, e.g. http://127.0.0.1:54321 locally.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable/anon key. Safe to expose ONLY because every table has RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site origin used for auth email links, e.g. http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only — never prefix with NEXT_PUBLIC_ ---
# Supabase service-role/secret key. Bypasses RLS. Used only by
# src/lib/supabase/admin.ts for rate limiting and audit logging.
SUPABASE_SERVICE_ROLE_KEY=
# Salt for hashing IPs/emails in rate-limit keys. Any long random string.
RATE_LIMIT_SALT=

# --- Later phases (not read yet) ---
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# SPORTS_PROVIDER_BASE_URL=
# SPORTS_PROVIDER_API_KEY=
